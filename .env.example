DATABASE_URL=postgres://swaplook:swaplook_local@localhost:5548/swaplook?sslmode=disable
HTTP_ADDR=127.0.0.1:8088
APP_ORIGIN=http://127.0.0.1:5173
MERCHANT_TOKEN=replace-with-a-long-random-local-token
COOKIE_SECURE=false
RENDERER_MODE=simulator
PRIVATE_STORAGE_DIR=../.data/images
# Required only for actual YouCam mode. Never use a VITE_ prefix for secrets.
YOUCAM_API_KEY=
YOUCAM_GARMENT_DIR=../.data/garments
# Probe paths are relative to the project root. Use only authorized photos.
YOUCAM_PERSON_IMAGE=.data/youcam/person.jpg
YOUCAM_GARMENT_IMAGE=.data/garments/SL-002.jpg
YOUCAM_PROBE_DIR=.data/probe
# Optional built frontend when running the Go API directly; relative to swaplook_BE.
STATIC_DIR=
# Docker Compose app profile uses a single origin for the UI and API.
CONTAINER_APP_ORIGIN=http://127.0.0.1:8088

# Actual-mode credit protection (generations, not units). Daily and client windows reset at UTC midnight.
PREVIEW_DAILY_LIMIT=25
PREVIEW_TOTAL_LIMIT=150
PREVIEW_CLIENT_DAILY_LIMIT=5
# Optional folder of consented model photos so visitors need not upload their own. Leave empty to disable.
# It must contain models.json: [{"id":"model-1","name":"Model 1","note":"...","file":"model-1.jpg"}] (max 8).
DEMO_MODELS_DIR=
CONTAINER_DEMO_MODELS_DIR=
# Only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
